---
const { label } = Astro.props;


---

<div class="toggleBlock">
    <button>&#9656;</button>
    <span>{label}</span>
    <div>
        <slot />
    </div>
</div>


<style lang="scss">
    @use "/src/styles/index" as *;
    
    .toggleBlock {
        background-color: rgb(253, 253, 253);
        border: 1px solid rgb(222, 222, 222);
        border-radius: 10px;


        padding: 15px 20px;
        margin: 20px 0px;
    }

    .toggleBlock button {
        background-color: transparent;
        border: 1.5px solid rgb(0, 0, 0);
        border-radius: 50%;
    }


    .toggleBlock span {
        text-decoration: underline;
        margin-left: 5px;
    }

    .toggleBlock:hover {
        cursor: pointer;
    }
</style>