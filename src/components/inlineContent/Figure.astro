---
/*
 * An article figure: an optimized image with an optional caption.
 *
 * Authored in MDX prose with no import — [...slug].astro injects it via
 * <Content components={{ Figure }}>, same as Cite:
 *
 *     <Figure src="standing-response.png" alt="..." caption="..." width="partial" />
 *
 * The image file lives in src/images/articles/ and is referenced by filename
 * only. import.meta.glob below bundles every image in that folder as an
 * ImageMetadata module, which lets Astro's <Image> generate an optimized,
 * properly-sized file at build time. An unknown filename fails the build and
 * lists what is available.
 *
 * alt is required; use alt="" only for purely decorative images.
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: string; // filename inside src/images/articles/, e.g. "diagram.png"
    alt: string;
    caption?: string;
    width?: "full" | "partial"; // partial = 60% width, centered. Default full.
}

const { src, alt, caption, width = "full" } = Astro.props;

if (alt === undefined) {
    throw new Error(`Figure "${src}": alt text is required (use alt="" only if purely decorative)`);
}

// Bundle every article image; keys are absolute-from-project-root paths
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/images/articles/**/*.{png,jpg,jpeg,webp,avif,gif}",
    { eager: true }
);

const imagePath = `/src/images/articles/${src}`;
const image = images[imagePath];

if (!image) {
    const available = Object.keys(images)
        .map((path) => path.replace("/src/images/articles/", ""))
        .join(", ") || "(folder is empty)";
    throw new Error(`Figure: image "${src}" not found in src/images/articles/. Available: ${available}`);
}
---

<figure class={width}>
    <Image src={image.default} alt={alt} />
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style lang="scss">
    @use "/src/styles/index" as *;

    figure {
        margin: 2rem 0;

        // <Image> renders the <img> as a child component, so it doesn't get
        // this component's scope attribute — :global() reaches it
        :global(img) {
            display: block;
            max-width: 100%;
            height: auto;
        }

        &.partial {
            width: 60%;
            margin-inline: auto;
        }

        figcaption {
            margin-top: .5rem;
            font-size: .9rem;
            color: #747474;
            text-align: center;
        }
    }

    @media only screen and (max-width: $breakpoint) {
        figure.partial {
            width: 100%;
        }
    }
</style>
