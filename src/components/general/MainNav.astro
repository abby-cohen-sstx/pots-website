---
/* Next step: animate and polish display/summary toggles in narrow popup.
https://blog.logrocket.com/styling-html-modern-css/

Search could be next? (Eek!)
*/

import NavHome from "./NavHome.astro"

import SearchBar from "./SearchBar.astro"

import Arrow from "@/images/NavArrow.svg"
import OpenMenuIcon from "@/images/OpenMenuIcon.svg"
import CloseMenuIcon from "@/images/CloseMenuIcon.svg"
import SearchIcon from "@/images/SearchIcon.svg"
import SettingsIcon from "@/images/SettingsIcon.svg"

const ARTICLES_DISPLAY_LIMIT = 4;

// Load all articles
import { getCollection } from "astro:content";
import { ARTICLE_ORDER } from "@/constants/articleOrder";
import { COLLECTION_LIST } from "@/constants/collectionList"

const articles = await getCollection("articles");

// Lookup table: id (article name) -> position in ARTICLE_ORDER
const orderIndex = new Map<string, number>();
ARTICLE_ORDER.forEach((id, index) => orderIndex.set(id, index));

// Sort all articles
articles.sort((a, b) => {
  const ai = orderIndex.get(a.id);
  const bi = orderIndex.get(b.id);

  // Both explicitly ordered:
  if (ai !== undefined && bi !== undefined) return ai - bi;

  // Priortize explicitly ordered articles over non-explicitly ordered:
  if (ai !== undefined) return -1;
  if (bi !== undefined) return 1;

  // Neither ordered:
  return 0;
});

// Group by collection
const byCollection = articles.reduce((accumulator, article) => {
    const collection = article.data.collection;
    const type = article.data.type;

    // Intiialize collection if it doesn't exist:
    accumulator[collection] = accumulator[collection] || {};

    // Initialize type array if it doesn't exist:
    accumulator[collection][type] = accumulator[collection][type] || [];

    // Push article into the correct collection and type group
    accumulator[collection][type].push(article);

    return accumulator;
}, /** @type {Record<string, typeof articles>} */ ({})); // {collection1: [{article1},{article2}], collection2: [...], ...}

---

<nav id="outerNavContainer">
    <div class="topNav">

        <!--Default nav bar on wide screens -->
        <ul class="wideNav">
            <li><NavHome /></li>
            <li>
                <!--List of collections -->
                <ul id="wideNavLinks">
                    {COLLECTION_LIST.map(collection => (
                        <li class="collectionLink">
                            <span id={`linkTo${collection}`}>
                                <a href={`/collections/${collection.toLowerCase()}`}>{collection}</a>
                                <button id={`buttonFor${collection}`}>
                                    <Arrow />
                                </button>
                            </span>
                        </li>
                    ))}
                </ul>
            </li>
            
            <li class="wideIconsContainer">
                <div class="svgContainer settingsContainer">
                    <SettingsIcon />
                </div>
                <div class="svgContainer searchContainer">
                    <SearchIcon />
                </div>
            </li>
        </ul>

        <!--Appears when hovering over wideNavLinks -->
        <div id="widePopup">
            {COLLECTION_LIST.map(collection => {
                const types = Object.keys(byCollection[collection] ?? {});

                return(
                    <div class={`collectionContainer ${collection}`} id={`containerFor${collection}`} style="display: none;">
                        {types.map(type => (
                            <div class="typeContainer">
                                <h2>{type.toLocaleUpperCase()}</h2>

                                <ul>
                                    {(byCollection[collection]?.[type] ?? []).slice(0, ARTICLES_DISPLAY_LIMIT).map(article => (
                                        <li>
                                            <a href={`/articles/${article.id}`} class="linkInList">
                                                {article.data.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                )
                
            })}
        </div>

        <!--Default nav bar on narrow screens -->
        <ul class="narrowNav">
            <li class="narrowToggleContainer">
                <label for="narrowMenuToggle" class="svgContainer">
                    <OpenMenuIcon />
                </label>
            </li>

            <li>
                <NavHome />
            </li>
            
            <li class="svgContainer searchContainer">
                <SearchIcon />
            </li>
        </ul>
    </div>
</nav>

<!--Saves narrow popup state without javascript -->
<input type="checkbox" id="narrowMenuToggle" style="display:none" checked />

<!--Appears when the menu button is pressed on narrowNav -->
<nav id="narrowPopup">
    <ul class="popupHeader">
        <li class="narrowToggleContainer">
            <label for="narrowMenuToggle" class="svgContainer">
                <CloseMenuIcon />
            </label>
        </li>

        <li>
            <NavHome />
        </li>

        <li class="svgContainer settingsContainer">
            <SettingsIcon />
        </li>
    </ul>

    <SearchBar />

    <menu>
        <h1>Categories</h1>
        {COLLECTION_LIST.map(collection => {
        const types = Object.keys(byCollection[collection] ?? {});

        return(
            <li id={`containerFor${collection}`} class="outerListItem">
                <details>
                    <summary>{collection}</summary>
                    <div class="detailsPadding">
                        {types.map(type => (
                            <div class="narrowTypeContainer">
                                <h2>{type.toLocaleUpperCase()}</h2>

                                <ul>
                                    {(byCollection[collection]?.[type] ?? []).slice(0, ARTICLES_DISPLAY_LIMIT).map(article => (
                                        <li>
                                            <a href={`/articles/${article.id}`} class="linkInList">
                                                {article.data.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </details>
            </li>
        )
        
    })}


    </menu>
</nav>

<script is:inline>
    // --- HANDLE NAV OPENING, LOADING, AND CLOSING ---

    const wideNavLinks = document.getElementById("wideNavLinks");
    const widePopup = document.getElementById("widePopup");
    const popupButtons = wideNavLinks.querySelectorAll("button");
    const allContainers = widePopup.getElementsByClassName("collectionContainer");

    const MENU_CLOSE_DELAY = 200; // ms
    
    let closeTimer = null;
    let toggleTimer = null;
    let canToggle = true;
    let currentCollection = null;

    // Functions for wide nav popup
    function hidePopup() {
        widePopup.style.display = "none";
        popupButtons.forEach(button => button.style.transform = "rotate(90deg)");
    }

    function showPopup() {
        cancelCloseTimer();
        widePopup.style.display = "flex";
    }

    function startCloseTimer() {
        cancelCloseTimer();
        closeTimer = setTimeout(() => {
            hidePopup();
            closeTimer = null;
        }, MENU_CLOSE_DELAY);
    }

    function cancelCloseTimer() {
        if (closeTimer) {
            clearTimeout(closeTimer);
        }
        closeTimer = null;
    }

    // Delay when the popup closes
    wideNavLinks.addEventListener("mouseenter", cancelCloseTimer);
    wideNavLinks.addEventListener("mouseleave", startCloseTimer);

    widePopup.addEventListener("mouseenter", cancelCloseTimer);
    widePopup.addEventListener("mouseleave", startCloseTimer);

    // Functions for toggle arrows next to category links
    function startToggleTimer() {
        cancelToggleTimer();
        canToggle = false;
        toggleTimer = setTimeout(() => {
            canToggle = true;
        }, 1)
    }

    function cancelToggleTimer() {
        if (toggleTimer) {
            clearTimeout(toggleTimer);
        }
        toggleTimer = null;
        canToggle = true;
    }

    // Loads collection into wide nav popup
    function loadCollection(collection) {
        const collectionContainer = document.getElementById(`containerFor${collection}`);

        if (collectionContainer) {
            // Hide all other collection containers
            for (const container of allContainers) {
                if (container !== collectionContainer) {
                    container.style.display = "none";
                }
            }

            // Show the relevant collection container
            collectionContainer.style.display = "flex";

            currentCollection = collection;

            popupButtons.forEach(button => {
                const buttonCollection = button.id.replace(/^buttonFor/, "");

                if (buttonCollection === collection) {
                    button.style.transform = "rotate(180deg)";
                } else {
                    button.style.transform = "rotate(90deg)";
                }
            });
        }
    }

    // Open nav menu on mouse hover or touchpad tap
    wideNavLinks.querySelectorAll("li").forEach(link => {
        link.addEventListener("mouseenter", (event) => {
            const span = event.target.querySelectorAll("span")[0]

            if (span && wideNavLinks.contains(span)) {
                showPopup();

                const collection = span.id.replace(/^linkTo/, "");
                loadCollection(collection);
                startToggleTimer();
            }
            });
    })

    // Toggle menu when arrows are clicked. canToggle prevents this from double-triggering with "mouseenter" for mobile users
    popupButtons.forEach(button => {
        button.addEventListener("click", () => {
            const collection = button.id.replace(/^buttonFor/, "");

            if ((currentCollection === collection) & canToggle) {
                hidePopup();
                currentCollection = null;
                cancelToggleTimer();
                return;
            }

            loadCollection(collection);
            showPopup();
            cancelToggleTimer();
        });
    });

    // Close poppup if the user clicks/taps anywhere else on the page
    document.body.addEventListener("click", (event) => {
        if (!wideNavLinks.contains(event.target) && !widePopup.contains(event.target)) {
            hidePopup();
        }
    });


    // Hide nav bar when scrolling up
    const outerContainer = document.getElementById("outerNavContainer");

    let lastY = window.scrollY;
    let hidden = false;

    window.addEventListener("scroll", () => {
        const currentY = window.scrollY;

        if (currentY > lastY && !hidden) { // Scrolling down
            outerContainer.style.transform = "translateY(-100%)";
            hidePopup()
            hidden = true;

        } else if (currentY < lastY && hidden) { // Scrolling up
            outerContainer.style.transform = "translateY(0)";
            hidden = false;
        }

        lastY = currentY;
    });

</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    $nav-height: 3rem;
    $arrow-size: .6rem;
    $icon-size: 1.5rem;
    $nav-bar-background: #fefcfc;
    $nav-bar-border: rgb(193, 193, 193);
    $link-underline: #3e3e3e;

    svg {
        width: $icon-size;
        height: $icon-size;
    }

    .svgContainer {
        display: block;
        width: $icon-size;
        height: $icon-size;

        &:hover {
            cursor:pointer;
        }
    }

    .searchContainer {
        transition: transform .15s ease-in-out;

        &:hover {
            transform: rotate(15deg);
        }
    }

    .settingsContainer {
        transition: transform .3s ease-in-out;

        &:hover {
            transform: rotate(180deg);
        }
    }

    .linkInList {
        font-size: 1.1rem;
        margin-bottom: .3rem;
        padding: .2rem .2rem .2rem 0rem;

        text-decoration: none;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;

        &:hover {
            text-decoration: underline;
            text-decoration-color: $link-underline;
        }
    }

    /* Top nav bar */
    #outerNavContainer {
        position: sticky;
        top: 0px;
        width: 100%;

        transition: transform 0.15s ease-in-out;

        .topNav {
            width: 100%;
            height: $nav-height;
            border-bottom: 1px solid $nav-bar-border;
            background-color: $nav-bar-background;

        }
    }

    .wideNav, .narrowNav {
        width: 100%;
        height: 100%;

        list-style-type: none;
    }

    /* Wide version of the top nav bar */
    .wideNav {
        @include flex-row-space-evenly;

        .wideIconsContainer {
            @include flex-row-space-between;
            gap: .5rem;
        }
    }

    #wideNavLinks {
        @include flex-row-center;
        list-style: none;

        li {
            margin-right: -1px; // Fixes slight gap between links when moving mouse between them

            &:hover {
                cursor: pointer;

                a {
                    text-decoration: underline;
                    text-decoration-color: $link-underline;

                }
            }
            
            span {
                padding: 1rem 1rem;

                display: flex;
                @include flex-row-center;
                gap: .2rem;
            }

            a {
                text-decoration: none;
            }

            button {
                border: none;
                background: none;
                padding: .5rem;

                transform: rotate(90deg);
                transition: transform .1s ease-out;

                svg {
                    width: $arrow-size;
                    height: $arrow-size;
                }

                &:hover {
                    cursor: pointer;
                }
            }
        }
    }

    /* Popup below wide nav bar */
    #widePopup {
        width: 100%;
        background-color: $nav-bar-background;
        border-bottom: 1px solid $nav-bar-border;
        padding: 1.5rem .5rem 2.5rem .5rem;

        @include flex-row-center;

        display: none;

        .collectionContainer {
            width: 80%;
            max-width: 1000px;
            @include flex-row-space-between;

            .typeContainer {
                width: 45%;

                h2 {
                    font-size: 1.2rem;
                    margin-bottom: .4rem;
                }

                ul {
                    list-style: none;
                }
            }
        }

        .Resources {
            @include flex-row-center;
        }
    }

    /* Narrow version of the top nav bar. Also applies to header of narrow popup */
    .narrowNav, .popupHeader {
        display: none;
        @include flex-row-space-between;
        padding-inline: 20px;

        .narrowToggleContainer {
            svg {
                transition: transform .2s ease-out;

                &:hover {
                    transform: scale(1.05);
                }
            }
        }
    }


    /* Switch between narrow and wide */
    @media only screen and (max-width: $breakpoint) {
        .wideNav {
            display: none;
        }
        .narrowNav {
            display: flex;
        }
    }

    @media only screen and (min-width: $breakpoint) {
        .wideNav {
            display: flex;
        }
        .narrowNav {
            display: none;
        }
    }


    /* --- POPUP MENU FOR NARROW SCREENS ---

    /* show narrow popup when checkbox is checked */
    #narrowMenuToggle:checked ~ #narrowPopup {
        display: flex;
    }

    /* prevent background scrolling when menu is open */
    body:has(#narrowMenuToggle:checked) {
        overflow: hidden;
    }

    #narrowPopup {
        width: 100%;
        height: 100vh;

        position: fixed;
        inset: 0;
        background-color: $nav-bar-background;
        overflow-y: scroll;
        z-index: 1000;
        pointer-events: auto; /* ensure it captures clicks */

        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 2rem; /* adjust when search bar is finalized */

        .popupHeader {
            width: 100%;
            list-style: none;
            min-height: $nav-height;
            border-bottom: 1px solid $nav-bar-border;
        }

        menu {
            list-style: none;
            width: 80%;

            h1 {
                margin-bottom: 2rem;
            }

            h2 {
                font-size: 1.2rem;
                margin: 2rem 0rem 1rem 0rem;
            }

            .outerListItem {
                margin-bottom: .7rem;
                padding: .5rem .5rem .5rem 0rem;

                summary {
                    font-size: 1.4rem;

                    &:hover {
                        cursor: pointer;
                    }
                }

                .detailsPadding {
                    padding-left: 2.5rem;

                    .narrowTypeContainer {
                        margin-bottom: 4rem;
                    }
                }
                
                ul {
                    list-style: none;

                    a {
                        margin-bottom: .3rem;
                    }
                }
            }
        }

    }

</style>

