---
import NavHome from "./NavHome.astro";
import SearchWidget from "./SearchWidget.astro";
import SearchIconWidget from "./SearchIconWidget.astro";

import Arrow from "@/images/NavArrow.svg";
import OpenMenuIcon from "@/images/OpenMenuIcon.svg";
import CloseMenuIcon from "@/images/CloseMenuIcon.svg";
import SearchIcon from "@/images/SearchIcon.svg";
import SettingsIcon from "@/images/SettingsIcon.svg";

const ARTICLES_DISPLAY_LIMIT = 4;

// Load all articles
import { getCollection } from "astro:content";
import { ARTICLE_ORDER } from "@/globals/articleOrder";
import { COLLECTION_LIST } from "@/globals/collectionList";


const articles = await getCollection("articles");

// Lookup table: id (article name) -> position in ARTICLE_ORDER
const orderIndex = new Map<string, number>();
ARTICLE_ORDER.forEach((id, index) => orderIndex.set(id, index));

// Sort all articles
articles.sort((a, b) => {
  const ai = orderIndex.get(a.id);
  const bi = orderIndex.get(b.id);

  // Both explicitly ordered:
  if (ai !== undefined && bi !== undefined) return ai - bi;

  // Priortize explicitly ordered articles over non-explicitly ordered:
  if (ai !== undefined) return -1;
  if (bi !== undefined) return 1;

  // Neither ordered:
  return 0;
});

// Group by collection
const byCollection = articles.reduce((accumulator, article) => {
    const collection = article.data.collection;
    const type = article.data.type;

    // Intiialize collection if it doesn't exist:
    accumulator[collection] = accumulator[collection] || {};

    // Initialize type array if it doesn't exist:
    accumulator[collection][type] = accumulator[collection][type] || [];

    // Push article into the correct collection and type group
    accumulator[collection][type].push(article);

    return accumulator;
}, /** @type {Record<string, typeof articles>} */ ({})); // {collection1: [{article1},{article2}], collection2: [...], ...}

---

<nav id="outerNavContainer">
    <div class="topNav">

        <!--Default nav bar on wide screens -->
        <ul class="wideNav">
            <li><NavHome /></li>
            <li>
                <!--List of collections -->
                <ul id="wideNavLinks">
                    {COLLECTION_LIST.map(collection => (
                        <li class="collectionLink">
                            <span id={`linkTo${collection}`}>
                                <a href={`/collections/${collection.toLowerCase()}`}>{collection}</a>
                                <button id={`buttonFor${collection}`}>
                                    <Arrow />
                                </button>
                            </span>
                        </li>
                    ))}
                </ul>
            </li>
            
            <li class="wideIconsContainer">
                <div class="svgContainer settingsContainer">
                    <SettingsIcon />
                </div>
                <div class="searchOuterContainer">
                    <div class="svgContainer searchIconContainer">
                        <SearchIconWidget />
                    </div>
                    <div class="searchBarContainer">
                        <SearchWidget />
                    </div>
                </div>
            </li>
        </ul>

        <!--Appears when hovering over wideNavLinks -->
        <div id="widePopup">
            {COLLECTION_LIST.map(collection => {
                const types = Object.keys(byCollection[collection] ?? {});

                return(
                    <div class={`collectionContainer ${collection}`} id={`containerFor${collection}`} style="display: none;">
                        {types.map(type => (
                            <div class="typeContainer">
                                <h2>{type.toLocaleUpperCase()}</h2>

                                <ul>
                                    {(byCollection[collection]?.[type] ?? []).slice(0, ARTICLES_DISPLAY_LIMIT).map(article => (
                                        <li>
                                            <a href={`/articles/${article.id}`} class="linkInList">
                                                {article.data.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                )
                
            })}
        </div>

        <!--Default nav bar on narrow screens -->
        <ul class="narrowNav">
            <li class="narrowToggleContainer">
                <label for="narrowMenuToggle" class="svgContainer">
                    <OpenMenuIcon />
                </label>
            </li>

            <li>
                <NavHome />
            </li>
            
            <li class="svgContainer searchIconContainer">
                <SearchIconWidget />
            </li>
        </ul>
    </div>
</nav>

<!--Saves narrow popup state without javascript -->
<input type="checkbox" id="narrowMenuToggle" style="display:none" />

<!--Appears when the menu button is pressed on narrowNav -->
<nav id="narrowPopup">
    <ul class="popupHeader">
        <li class="narrowToggleContainer">
            <label for="narrowMenuToggle" class="svgContainer">
                <CloseMenuIcon />
            </label>
        </li>

        <li>
            <NavHome />
        </li>

        <li class="svgContainer settingsContainer">
            <SettingsIcon />
        </li>
    </ul>

    <SearchWidget />

    <menu>
        <h1>Categories</h1>
        {COLLECTION_LIST.map(collection => {
        const types = Object.keys(byCollection[collection] ?? {});

        return(
            <li id={`containerFor${collection}`} class="outerListItem">
                <details>
                    <summary>{collection}</summary>
                    <div class="detailsPadding">
                        {types.map(type => (
                            <div class="narrowTypeContainer">
                                <h2>{type.toLocaleUpperCase()}</h2>

                                <ul>
                                    {(byCollection[collection]?.[type] ?? []).slice(0, ARTICLES_DISPLAY_LIMIT).map(article => (
                                        <li>
                                            <a href={`/articles/${article.id}`} class="linkInList">
                                                {article.data.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </details>
                <hr />
            </li>
        )
        
    })}


    </menu>
</nav>

<script>
    import initMainNav from "./main-nav-menu";
    initMainNav();
</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    $nav-height: 3rem;
    $arrow-size: .6rem;
    $nav-bar-background: #fefcfc;
    $nav-bar-border: rgb(193, 193, 193);
    $link-underline: #3e3e3e;

    $search-breakpoint: 65rem;

    svg {
        width: $nav-icon-size;
        height: $nav-icon-size;
    }

    .svgContainer {
        display: block;
        width: $nav-icon-size;
        height: $nav-icon-size;

        &:hover {
            cursor:pointer;
        }
    }

    .searchIconContainer {
        transition: transform .15s ease-in-out;
        display: none;

        &:hover {
            transform: rotate(15deg);
        }
    }

    .settingsContainer {
        transition: transform .3s ease-in-out;

        &:hover {
            transform: rotate(180deg);
        }
    }

    .linkInList {
        font-size: 1.1rem;
        margin-bottom: .3rem;
        padding: .2rem .2rem .2rem 0rem;

        text-decoration: none;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;

        &:hover {
            text-decoration: underline;
            text-decoration-color: $link-underline;
        }
    }

    /* Top nav bar */
    #outerNavContainer {
        position: sticky;
        top: 0px;
        width: 100%;

        transition: transform 0.15s ease-in-out;
        z-index: 1000;

        .topNav {
            width: 100%;
            height: $nav-height;
            border-bottom: 1px solid $nav-bar-border;
            background-color: $nav-bar-background;

        }
    }

    .wideNav, .narrowNav {
        width: 100%;
        height: 100%;

        list-style-type: none;
    }

    /* Wide version of the top nav bar */
    .wideNav {
        @include flex-row-space-evenly;

        .wideIconsContainer {
            @include flex-row-space-between;
            gap: .5rem;
        }
    }

    #wideNavLinks {
        @include flex-row-center;
        list-style: none;

        li {
            margin-right: -1px; // Fixes slight gap between links when moving mouse between them

            &:hover {
                cursor: pointer;

                a {
                    text-decoration: underline;
                    text-decoration-color: $link-underline;

                }
            }
            
            span {
                padding: 1rem 1rem;

                display: flex;
                @include flex-row-center;
                gap: .2rem;
            }

            a {
                text-decoration: none;
            }

            button {
                border: none;
                background: none;
                padding: .5rem;

                transform: rotate(90deg);
                transition: transform .1s ease-out;

                svg {
                    width: $arrow-size;
                    height: $arrow-size;
                }

                &:hover {
                    cursor: pointer;
                }
            }
        }
    }

    /* Popup below wide nav bar */
    #widePopup {
        width: 100%;
        background-color: $nav-bar-background;
        border-bottom: 1px solid $nav-bar-border;
        padding: 1.5rem .5rem 2.5rem .5rem;

        @include flex-row-center;

        display: none;

        .collectionContainer {
            width: 80%;
            max-width: 1000px;
            @include flex-row-space-between;

            .typeContainer {
                width: 45%;

                h2 {
                    font-size: 1.2rem;
                    margin-bottom: .4rem;
                }

                ul {
                    list-style: none;
                }
            }
        }

        .Resources {
            @include flex-row-center;
        }
    }

    /* Narrow version of the top nav bar. Also applies to header of narrow popup */
    .narrowNav, .popupHeader {
        display: none;
        @include flex-row-space-between;
        padding-inline: 20px;

        .narrowToggleContainer {
            svg {
                transition: transform .2s ease-out;

                &:hover {
                    transform: scale(1.05);
                }
            }
        }
    }

    /* Switch between narrow and wide */
    @media only screen and (max-width: $breakpoint) {
        .wideNav {
            display: none;
        }
        
        .narrowNav {
            display: flex;
        }
    }

    @media only screen and (min-width: $breakpoint) {
        .wideNav {
            display: flex;
        }

        .narrowNav {
            display: none;
        }
    }

    /* Toggle search bar or search icon based on screen width */
    @media only screen and (max-width: $search-breakpoint) {
        .searchIconContainer {
            display: block;
        }

        .searchBarContainer {
            display: none;
        }
    }

    @media only screen and (min-width: $search-breakpoint) {
        .searchIconContainer {
            display: none;
        }

        .searchBarContainer {
            display: block;
        }
    }


    /* --- POPUP MENU FOR NARROW SCREENS ---

    /* show narrow popup when checkbox is checked */
    #narrowMenuToggle:checked ~ #narrowPopup {
        display: flex;
    }

    /* prevent background scrolling when menu is open */
    body:has(#narrowMenuToggle:checked) {
        overflow: hidden;
    }

    #narrowPopup {
        @include fullscreen-popup;

        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 2rem; /* adjust when search bar is finalized */

        background-color: $nav-bar-background;
        z-index: 1001;

        .popupHeader {
            width: 100%;
            list-style: none;
            min-height: $nav-height;
            border-bottom: 1px solid $nav-bar-border;
        }

        menu {
            list-style: none;
            width: 80%;

            h1 {
                margin-bottom: 2rem;
            }

            h2 {
                font-size: 1.2rem;
                margin-bottom: .5rem;
            }

            /* Ensure that browser supports interpolate-size */
            @supports (interpolate-size: allow-keywords) {
                details {
                    interpolate-size: allow-keywords; /* Required to animate block-size: auto */
                }

                /* closed state */
                details::details-content {
                    block-size: 0;

                    /* Browser sets content-visibility: hidden when closed, so it needs to be part of the transition */
                    transition: content-visibility, block-size;
                    transition-duration: .6s;

                    transition-behavior: allow-discrete; /* Gradual transition for content-visibility */
                    overflow: hidden;
                }

                /* open state */
                details[open]::details-content {
                    block-size: auto;
                }
            }

            .outerListItem {
                padding: .5rem .5rem .5rem 0rem;

                summary {
                    font-size: 1.4rem;
                    list-style: none;
                    position: relative;

                    /* Space for custom icon */
                    padding-left: 1.5rem;

                    cursor: pointer;

                    /* Replace default arrow with custom arrow and animate open/close */

                    /* Closed state */
                    &::before {
                        content: "";
                        position: absolute;
                        left: 0;
                        top: 50%;
                        transform: translateY(-50%) rotate(90deg);

                        width: 1rem;
                        height: 1rem;

                        /* Must set background insteaad of list-style-image for customization */
                        background-image: url("@/images/NavArrow.svg");
                        background-size: contain;
                        background-repeat: no-repeat;
                        transition: transform 0.4s ease;
                        pointer-events: none;
                    }
                }

                /* Rotate arrow when open */
                details[open] summary::before {
                    transform: translateY(-50%) rotate(180deg);
                }

                .detailsPadding {
                    padding-left: 2.5rem;

                    .narrowTypeContainer {
                        margin-block: 2.5rem;
                    }
                }
                
                ul {
                    list-style: none;

                    a {
                        margin-bottom: .3rem;
                    }
                }

                hr {
                    margin-block: .5rem 1.5rem;
                }

                    summary::marker {
                        width: $arrow-size;
                    }
            }
        }

    }

</style>

