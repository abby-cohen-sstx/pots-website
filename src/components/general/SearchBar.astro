---
import SearchIcon from "@/images/SearchIcon.svg"
import CloseIcon from "@/images/CloseIcon.svg"

---

<form class="wrapper" id="searchWrapper">
    <SearchIcon class="searchIcon" id="searchIcon" />
    <input class="searchBox" placeholder="Search" type="text" id="navSearch">
    <CloseIcon class="clearIcon" id="clearIcon" />
</form>

<script>
    import initSearchBar from "./search"
    initSearchBar()
</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    $default-width: 100px;
    $icon-size: 1.25rem;
    $icon-padding: .4rem;
    $search-height: calc($icon-size + ($icon-padding * 2));
    $icon-top-pos: calc(($search-height - $icon-size) / 2);

    /* Access SCSS variables in JS */
    :root {
        --default-width: #{$default-width};
        --search-height: #{$search-height};
    }
    

    .wrapper {
        position: relative;
        width: $search-height;
        height: $search-height;

        svg {
            position: absolute;
            width: $icon-size;
            height: $icon-size;
            cursor: pointer;
            top: $icon-top-pos;
        }

        .searchIcon {
            left: $icon-padding;
        }

        .clearIcon {
            right: $icon-padding;
            display: none;
        }

        .searchBox {
            border: 1px solid grey;
            border-radius: calc($search-height / 2);
            height: 100%;
            width: 100%;
            padding: 0;
        }
    }

    
    
