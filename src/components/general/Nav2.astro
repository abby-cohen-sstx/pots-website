---
import { getCollection } from "astro:content";
import { ARTICLE_ORDER } from "@/pages/articles/order";


const articles = await getCollection("articles");

// Group by collection and sort within each group
const byCollection = articles.reduce((acc, entry) => {
  const c = entry.data.collection; // "Collection1" | "Collection2" | "Collection3"
  (acc[c] ??= []).push(entry);
  return acc;
}, /** @type {Record<string, typeof articles>} */ ({}));

for (const c of Object.keys(byCollection)) {
  byCollection[c].sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
}

// <string, number> = <article id, position in ARTICLE_ORDER>
const articlePositions = new Map<string, number>(
	ARTICLE_ORDER.map((id, i) => [id, i])
); 

const sortedArticles = [...articles].sort((a, b) => {
	// If an article isn't in ARTICLE_ORDER, assign it a very large rank so it appears at the end
	const rankA = articlePositions.get(a.id) ?? Number.MAX_SAFE_INTEGER;
	const rankB = articlePositions.get(b.id) ?? Number.MAX_SAFE_INTEGER;

	// If this returns a negative value, a comes before b. If it returns a positive value, b comes before a
	// a.id.localeCompare(b.id) is used as a tiebreaker so that articles not in ARTICLE_ORDER are sorted alphabetically (when rankA - rankB = 0)
	return rankA - rankB || a.id.localeCompare(b.id);
});

// Keep a stable order (matches your enum)
const collections = ["Collection1", "Collection2", "Collection3"];
---

<nav class="site-nav" aria-label="Primary">
  <a class="brand" href="/">Home</a>

  <ul class="nav-list" role="list">
    {collections.map((c) => (
      <li class="dropdown">
        <a class="dropdown-trigger" href={`/collections/${c.toLowerCase()}`}>
          {c}
        </a>

        <ul class="dropdown-menu" role="list" aria-label={`${c} articles`}>
          {(byCollection[c] ?? []).map((entry) => (
            <li>
              <a class="dropdown-item" href={`/articles/${entry.id}`}>
                <span class="title">{entry.data.title}</span>
                <span class="date">
                  {entry.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                  })}
                </span>
              </a>
            </li>
          ))}

          {(byCollection[c] ?? []).length === 0 && (
            <li class="empty">No articles yet</li>
          )}
        </ul>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: inline-block;
    padding: 0.5rem 0.6rem;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  .dropdown-trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 18rem;
    margin: 0.4rem 0 0;
    padding: 0.5rem;
    list-style: none;
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 0.75rem;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
    z-index: 10;
  }

  /* MVP open behavior: hover + keyboard focus within */
  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    display: block;
  }

  .dropdown-item {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.6rem;
    text-decoration: none;
    line-height: 1.2;
  }

  .dropdown-item:hover,
  .dropdown-item:focus-visible {
    background: rgba(0, 0, 0, 0.05);
    outline: none;
  }

  .title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .date {
    opacity: 0.65;
    font-size: 0.9em;
    white-space: nowrap;
  }

  .empty {
    padding: 0.5rem 0.6rem;
    opacity: 0.6;
  }
</style>
