---
import { getCollection } from "astro:content";
import { ARTICLE_ORDER } from "@/pages/articles/articleOrder";

const articles = await getCollection("articles");

// Group by collection
const byCollection = articles.reduce((accumulator, article) => {
  const collection = article.data.collection;

  // Adds a new array for this collection if it doesn't exist, then pushes the article into the correct collection group
  accumulator[collection] = accumulator[collection] || []; accumulator[collection].push(article);

  return accumulator;
}, /** @type {Record<string, typeof articles>} */ ({})); // {collection1: [{article1},{article2}], collection2: [...], ...}

// Lookup table: id (article name) -> position in ARTICLE_ORDER
const orderIndex = new Map<string, number>();
ARTICLE_ORDER.forEach((id, index) => orderIndex.set(id, index));

// Sort by custom order defined by ARTICLE_ORDER
for (const collection of Object.keys(byCollection)) {
byCollection[collection].sort((a, b) => {
  const ai = orderIndex.get(a.id);
  const bi = orderIndex.get(b.id);

  // Both explicitly ordered:
  if (ai !== undefined && bi !== undefined) return ai - bi;

  // Priortize explicitly ordered articles over non-explicitly ordered:
  if (ai !== undefined) return -1;
  if (bi !== undefined) return 1;

  // Neither ordered:
  return 0;
});
}

// Keep a stable order for collections. Should match enum in content.config.js
const collections = ["Collection1", "Collection2", "Collection3"];
---

<nav class="site-nav" aria-label="Primary">
  <a class="brand" href="/">Home</a>

  <ul class="nav-list" role="list">
    {collections.map((c) => (
      <li class="dropdown">
        <a class="dropdown-trigger" href={`/collections/${c.toLowerCase()}`}>
          {c}
        </a>

        <ul class="dropdown-menu" role="list" aria-label={`${c} articles`}>
          {(byCollection[c] ?? []).map((entry) => (
            <li>
              <a class="dropdown-item" href={entry.slug}>
                <span class="title">{entry.data.title}</span>
                <span class="date">
                  {entry.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                  })}
                </span>
              </a>
            </li>
          ))}

          {(byCollection[c] ?? []).length === 0 && (
            <li class="empty">No articles yet</li>
          )}
        </ul>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: inline-block;
    padding: 0.5rem 0.6rem;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  .dropdown-trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 18rem;
    margin: 0.4rem 0 0;
    padding: 0.5rem;
    list-style: none;
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 0.75rem;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
    z-index: 10;
  }

  /* MVP open behavior: hover + keyboard focus within */
  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    display: block;
  }

  .dropdown-item {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.6rem;
    text-decoration: none;
    line-height: 1.2;
  }

  .dropdown-item:hover,
  .dropdown-item:focus-visible {
    background: rgba(0, 0, 0, 0.05);
    outline: none;
  }

  .title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .date {
    opacity: 0.65;
    font-size: 0.9em;
    white-space: nowrap;
  }

  .empty {
    padding: 0.5rem 0.6rem;
    opacity: 0.6;
  }
</style>
