---
import NavIcons from "./NavIcons.astro"
import NavHome from "./NavHome.astro"
import NavLinks from "./NavLinks.astro"
import SearchBar from "./SearchBar.astro"

---

<div class="container">
    <div class="navContainer">
        <div class="navWide">
            <NavHome />
            <NavLinks />
            <NavIcons showSearch={true}/>
        </div>

        <div class="navNarrow">
            <div style="justify-self: left">
                <button id="openNavMenu">Menu</button>
            </div>

            <div style="justify-self: center">
                <NavHome />
            </div>
            
            <div style="justify-self: right">
                <NavIcons showSearch={false}/>
            </div>
        </div>
    </div>
</div>

<div class="popupMenu" id="popupMenu">
    <div class="buttonContainer">
        <button id="closeNavMenu">Close</button>
    </div>

    <div class="searchContainer">
        <SearchBar />
    </div>
    
    <div>
        <NavLinks class="columnLinks" />
    </div>

</div>

<style lang="scss">
    @use "/src/styles/index" as *;

    $nav-height: 45px;

    .container {
        @include flex-column-center;
    }

    .navContainer {
        width: 100vw;
        height: $nav-height;
        border-bottom: 1px solid #d0d0d0;
        background-color: #fefcfc;
    }

    .navWide, .navNarrow {
        width: 100%;
        height: 100%;
    }

    .navWide {
        @include flex-row-space-evenly;
    }

    .navNarrow {
        display: none;

        grid-template-columns: 1fr auto 1fr;
        align-items: center;
    }

    .popupMenu {
        width: 100vw;
        height: 100vh;

        position: fixed;
        inset: 0;
        overflow: auto;
        
        background-color: #d0d0d0;

        display: none;

        .is-open {
            @include flex-column-center;
        }

        .buttonContainer {
            height: $nav-height;
            width: 100%;
            @include flex-row-start;
        }

        .searchContainer {
            width: 100%;
            @include flex-row-center;
        }
    }

    .rowLinks {
        @include flex-row-center;
        gap: 40px;
    }
    
    .columnLinks {
        @include flex-column-center;
        margin-top: 50px;
        gap: 40px;
        font-size: 40px;
    }

    @media only screen and (max-width: $breakpoint) {
        .navWide {
            display: none;
        }
        .navNarrow {
            display: grid;
        }
    }
    
</style>

<script is:inline >
    const open = document.getElementById("openNavMenu");
    const close = document.getElementById("closeNavMenu");
    const popupMenu = document.getElementById("popupMenu");

    open.addEventListener("click", () => {
        popupMenu.classList.add("is-open");
        popupMenu.style.display = "block";
        lockScroll();
    })

    close.addEventListener("click", () => {
        popupMenu.classList.remove("is-open");
        popupMenu.style.display = "none";
        unlockScroll();
    })


    let scrollY = 0;

    function lockScroll() {
        scrollY = window.scrollY; // Saves current scroll position
        document.body.style.position = "fixed"; // Prevents scrolling by anchoring body to viewport. Causes scroll to jump to top of page (see next line)
        document.body.style.top = `-${scrollY}px`; // Offsets body to maintain current scroll position

        // Prevent layout shifts:
        document.body.style.left = "0";
        document.body.style.right = "0";
        document.body.style.width = "100%";
    }

    function unlockScroll() {
        // Remove inline styles to allow body to scroll again
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.left = "";
        document.body.style.right = "";
        document.body.style.width = "";

        // Reset scroll to previous position when menu was opened
        window.scrollTo(0, scrollY);
    }

</script>