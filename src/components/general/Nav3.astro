---
import NavHome from "./NavHome.astro"

import SettingsIcon from "./SettingsIcon.astro"
import SearchIcon from "./SearchIcon.astro"
import SearchBar from "./SearchBar.astro"


const collections = ["About POTS", "Symptom Management", "Resources"];
const ARTICLES_DISPLAY_LIMIT = 4;

// Load all articles
import { getCollection } from "astro:content";
import { ARTICLE_ORDER } from "@/pages/articles/articleOrder";

const articles = await getCollection("articles");

// Lookup table: id (article name) -> position in ARTICLE_ORDER
const orderIndex = new Map<string, number>();
ARTICLE_ORDER.forEach((id, index) => orderIndex.set(id, index));

// Sort all articles
articles.sort((a, b) => {
  const ai = orderIndex.get(a.id);
  const bi = orderIndex.get(b.id);

  // Both explicitly ordered:
  if (ai !== undefined && bi !== undefined) return ai - bi;

  // Priortize explicitly ordered articles over non-explicitly ordered:
  if (ai !== undefined) return -1;
  if (bi !== undefined) return 1;

  // Neither ordered:
  return 0;
});

// Group by collection
const byCollection = articles.reduce((accumulator, article) => {
    const collection = article.data.collection;
    const type = article.data.type;

    // Intiialize collection if it doesn't exist:
    accumulator[collection] = accumulator[collection] || {};

    // Initialize type array if it doesn't exist:
    accumulator[collection][type] = accumulator[collection][type] || [];

    // Push article into the correct collection and type group
    accumulator[collection][type].push(article);

    return accumulator;
}, /** @type {Record<string, typeof articles>} */ ({})); // {collection1: [{article1},{article2}], collection2: [...], ...}

---

<div id="outerNavContainer">
    <div class="topNav">
        <div class="navWide">
            <NavHome />
            <ul id="wideNavLinks" style="background-color:aqua">
                {collections.map(collection => (
                    <li>
                        <a href={`/collections/${collection.toLowerCase()}`} style="padding: 1.5rem 1rem;" id={`linkTo${collection}`}>
                            {collection}
                        </a>
                    </li>
                ))}
            </ul>
            <div>
                <SettingsIcon />
                <SearchIcon />
            </div>
        </div>

        <div id="widePopup">
            <div>
                {collections.map(collection => {
                    const types = Object.keys(byCollection[collection] ?? {});

                    return(
                        <div class="collectionContainer" id={`containerFor${collection}`} style="display: none;">
                            {types.map(type => (
                                <div class="typeContainer">
                                    <h2>{type}</h2>

                                    <ul>
                                        {(byCollection[collection]?.[type] ?? []).slice(0, ARTICLES_DISPLAY_LIMIT).map(article => (
                                            <li>
                                                <a href={`/articles/${article.id}`}>
                                                    {article.data.title}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    )
                    
                })}
            </div>
        </div>

        <div class="navNarrow">
            <div style="position: fixed; left: 1rem; top: 1rem;">
                <button id="openNavMenu">Menu</button>
            </div>

            <div style="position: fixed; left: 50%; top: 1rem; transform: translateX(-50%);">
                <NavHome />
            </div>
            
            <div style="position: fixed; right: 1rem; top: 1rem;">
                <SearchIcon />
            </div>
        </div>
    </div>
</div>

<script is:inline>
    const outerContainer = document.getElementById("outerNavContainer");

    let lastY = window.scrollY;
    let hidden = false;

    window.addEventListener("scroll", () => {
        const currentY = window.scrollY;

        if (currentY > lastY && !hidden) {
            // Scrolling down
            outerContainer.style.transform = "translateY(-100%)";
            hidden = true;
        } else if (currentY < lastY && hidden) {
            // Scrolling up
            outerContainer.style.transform = "translateY(0)";
            hidden = false;
        }

        lastY = currentY;
    });

    const wideNavLinks = document.getElementById("wideNavLinks");
    const widePopup = document.getElementById("widePopup");

    let canClose = true;

    wideNavLinks.addEventListener("mouseover", (event) => {
        if (event.target.tagName === "A") {
            widePopup.style.display = "flex";
            
            const id = event.target.id.split("linkTo")[1]; // Extract collection name from link id (e.g. "About POTS" from "linkToAbout POTS")
            const collectionContainer = document.getElementById(`containerFor${id}`); // Get corresponding collection container (e.g. "containerForAbout POTS")
            const allContainers = widePopup.getElementsByClassName("collectionContainer");

            if(collectionContainer) {
                // Hide all other collection containers
                for (const container of allContainers) {
                    if (container !== collectionContainer) {
                        container.style.display = "none";
                    }
                }

                // Show the relevant collection container
                collectionContainer.style.display = "block";
            }

            console.log(collectionContainer)
        }
    });

    widePopup.addEventListener("mouseover", () => {
        canClose = false; // Prevents popup from closing when hovering over it
    });

    widePopup.addEventListener("mouseout", () => {
        canClose = true; // Allows popup to close when mouse leaves it
    });

    wideNavLinks.addEventListener("mouseout", (event) => {
        if (event.target.tagName === "A" && canClose) {
            widePopup.style.display = "none";
        }
    });

</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    #outerNavContainer {
        width: 100vw;

        transition: transform 0.3s ease-in-out;
    }

    .topNav {
        width: 100%;
        height: 3rem;
        border-bottom: 1px solid #d0d0d0;
        background-color: #fefcfc;


        .navWide, .navNarrow {
            width: 100%;
            height: 100%;
        }

        .navWide {
            @include flex-row-space-evenly;
        }

        .navNarrow {
            display: none;

            grid-template-columns: 1fr auto 1fr;
            align-items: center;
        }

        #widePopup {
            width: 100%;
            background-color: rgb(255, 255, 255);
            border: 1px solid #d0d0d0;
            padding: 1rem;

            @include flex-row-center;

            display: none;

            .collectionContainer {
                @include flex-row-center;
            }
        }

        @media only screen and (max-width: $breakpoint) {
            .navWide {
                display: none;
            }
            .navNarrow {
                display: grid;
            }
        }
    }

    #wideNavLinks {
        @include flex-row-center;
        list-style: none;

        a {
            text-decoration: none;
            margin-right: -1px; // Fixes slight gap between links that causes mouseout when hovering between them

            &:hover {
                text-decoration: underline;
            }
        }
    }

</style>


