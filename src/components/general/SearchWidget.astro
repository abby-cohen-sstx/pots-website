---
import SearchIcon from "@/images/SearchIcon.svg"
import ClearIcon from "@/images/CloseIcon.svg"
---

<div class="search">
    <form class="widget wrapper searchWidgetForm">
        <SearchIcon class="searchIcon" />
        <input type="search" name="search" class="input" placeholder="Search...">
        <ClearIcon class="clearIcon" />
    </form>
</div>


<script>
    import * as u from "@/globals/utilities";

    const forms = u.getAllByQuery(".searchWidgetForm", HTMLFormElement);

    forms.forEach(form => {
        const input = u.getByQuery(".input", HTMLInputElement, form);
        const clearButton = u.getByQuery(".clearIcon", SVGElement, form);

        // Go to search.astro
        form.addEventListener("submit", (event) => {
            event.preventDefault();

            const formData = new FormData(form);
            const searchTerm = u.validateSearch(formData.get("search")?.toString().trim() || "");
            
            if(!searchTerm || searchTerm.length === 0) {
                return;
            }

            const url = new URL("/search", window.location.origin); // add the search path to the current origin
            url.searchParams.set("s", searchTerm);
            window.location.assign(url.toString()); // using assign instead of replace to maintain history
        });

        // Clear button
        clearButton.addEventListener("click", () => {
            input.value = "";
        });
    });
</script>

<style lang="scss">
    @use "/src/styles/index" as *;

</style> 