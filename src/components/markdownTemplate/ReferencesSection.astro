---
import type { Reference } from "@/globals/references";
import { formatCitation } from "@/globals/formatCitation";

interface Props {
    referenceList: Reference[] | undefined,
    showLinks: boolean,
    heading: string,
    // h2 on article pages (the article header is the page's h1);
    // reference-sources.astro passes h1 since this heading is its only one
    headingLevel?: "h1" | "h2",
}

const { referenceList, showLinks, heading, headingLevel = "h2" } = Astro.props as Props;
// A capitalized variable holding a tag name renders as that tag (dynamic tag)
const Heading = headingLevel;

---

<div class="headingContainer">
    <Heading>{heading}</Heading>
</div>

{referenceList && referenceList.length > 0 && (
    <ol>
        {referenceList.map(reference => (
            <li id={`ref-${reference.id}`}>
                {formatCitation(reference).map(run =>
                    run.italic ? <i>{run.text}</i> : run.text
                )}
                {" "}
                <a href={reference.link}>{reference.link}</a>
            </li>
        ))}
    </ol>
)}

{showLinks && (
    <>
    {referenceList && referenceList.length > 0
        ? (
        <>
            <hr class="light-hr">
            <p>
                In addition to the previously listed sources which are specific to this page, you can find a
                <a href="/reference-sources/">list of general reference sources here</a>
            </p>
        </>
        )

        : (<p style="margin-top: -1.5rem">
            This article does not have any specific citations, but it is based on
            <a href="/reference-sources/">this list of general reference sources</a>
        </p>)
    }
    </>
)}

<style lang="scss">
    @use "/src/styles/index" as *;

    $highlight-color: #e8fffd;

    .headingContainer {
        @include flex-row-space-between;
        margin-bottom: 3rem;

        // level varies (h1/h2) but the section heading always looks the same
        :is(h1, h2) {
            font-size: 2rem;
            font-weight: 700;
        }
    }

    @media only screen and (max-width: $breakpoint) {
        .headingContainer {
            @include flex-column-start;
            gap: .5rem;
        }
    }

    ol {
        list-style-position: inside;

        li {
            padding: .5rem;
            margin-bottom: 1.5rem;

            &:target {
                background-color: $highlight-color;
            }
        }

        a {
            text-decoration: underline 1.5px solid #646464;
        }
    }
</style>
