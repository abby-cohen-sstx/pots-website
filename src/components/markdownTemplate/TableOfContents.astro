---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[],
    position: "bottom" | "side",
}

const { headings, position } = Astro.props as Props;
// Prose headings run h2-h4; anything outside that range (a stray # or deep
// #####) is excluded rather than rendered unstyled
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 0 && (
    <nav class=`container ${position}Style` aria-label="Table of contents">
        <p aria-hidden="true">TABLE OF CONTENTS</p>
        <ul>
            {filteredHeadings.map((heading) => (
                <li class=`${position}TocLinks`>
                    <a href={`#${heading.slug}`} class={`depth${heading.depth}`}>{heading.text}</a>
                </li>
            ))}
        </ul>
    </nav>
)}

<style lang="scss">
    @use "/src/styles/index" as *;

    nav {
        margin-bottom: 2rem;
    }

    .sideStyle {
        max-width: 40ch;
        margin-left: 2rem;
    }

    .bottomStyle {
        max-width: 50ch;
    }

    p {
        font-weight: 550;
    }

    ul {
        list-style: none;

        li {
            margin-bottom: .25rem;
        }

        a {
            text-decoration: none;
            max-width: 100%;
            display: block;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;

            &:hover {
                text-decoration: underline;
            }
        }
    }

    .depth2 {
        font-weight: 450;
    }

    .depth3 {
        padding-left: 1rem;
        font-weight: 350;
    }

    .depth4 {
        padding-left: 2rem;
        font-weight: 300;
    }

    :global(article :is(h1, h2, h3, h4, h5, h6)) {
        scroll-margin-top: 5rem;
    }

</style>

