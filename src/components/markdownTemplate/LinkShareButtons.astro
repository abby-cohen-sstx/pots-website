---
import ShareArrow from "@/images/ShareArrow.svg";
import LinkIcon from "@/images/LinkIcon.svg";
---

<div class="container">
    <button class="svgContainer">
        <ShareArrow />
    </button>
    <button class="svgContainer" id="copyLinkButton" aria-label="Copy page link to clipboard">
        <LinkIcon />
    </button>
</div>

<script>
    import * as u from "@/globals/browserUtilities"

    document.addEventListener('DOMContentLoaded', () => {
        const copyButtons = u.getAllByQuery("#copyLinkButton", HTMLButtonElement);

        copyButtons.forEach((button) => {
            button.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(window.location.href);
                    button.setAttribute('aria-label', 'Link copied to clipboard');
                } catch (error) {
                    console.error('Unable to copy link to clipboard:', error);
                }
            });
        });
    });
</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    $icon-size: 1rem;
    $padding: 1.25rem;
    $hover-addition: .1rem;
    $icon-color: #4569EB;
    $icon-active: #4061db;
    $icon-border: #1d3486;

    .container {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: .4rem;
    }

    .svgContainer {
        
        width: calc($icon-size + $padding);
        height: calc($icon-size + $padding);

        display: flex;
        justify-content: center;
        align-items: center;

        background-color: $icon-color;
        border-radius: 100%;
        border: 2px solid $icon-border;
        cursor: pointer;
        
        &:hover svg {
            /*
            width: calc($icon-size + $hover-addition);
            height: calc($icon-size + $hover-addition);
            */

            transform: translateY(-1px);
        }

        &:active {
            // background-color: $icon-active;
            
            svg {
                transform: translateY(1px);
            }
        }
        
        
        

        svg {
            width: $icon-size;
            height: $icon-size;

            // transition: width 0.1s ease, height 0.1s ease;
        }
    }

</style>