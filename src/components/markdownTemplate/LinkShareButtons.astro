---
import ShareArrow from "@/images/ShareArrow.svg";
import LinkIcon from "@/images/LinkIcon.svg";
---

<div class="container">
    <div class="svgContainer">
        <ShareArrow />
    </div>
    <div class="svgContainer">
        <LinkIcon />
    </div>
</div>

<style lang="scss">
    @use "/src/styles/index" as *;

    $icon-size: 1rem;
    $padding: 1.25rem;
    $hover-addition: .1rem;
    $icon-color: #4569EB;

    .container {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: .4rem;
    }

    .svgContainer {
        
        width: calc($icon-size + $padding);
        height: calc($icon-size + $padding);

        display: flex;
        justify-content: center;
        align-items: center;

        background-color: $icon-color;
        border-radius: 100%;

        cursor: pointer;

        &:hover svg {
            width: calc($icon-size + $hover-addition);
            height: calc($icon-size + $hover-addition);
        }

        svg {
            width: $icon-size;
            height: $icon-size;

            transition: width 0.1s ease, height 0.1s ease;
        }
    }

</style>