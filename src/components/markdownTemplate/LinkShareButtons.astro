---
import ShareArrow from "@/images/ShareArrow.svg";
import LinkIcon from "@/images/LinkIcon.svg";
---

<div class="container">
    <!-- hidden until the script confirms navigator.share exists (mostly mobile);
         on browsers without it, the copy button next door covers the need -->
    <button type="button" class="svgContainer shareButton" aria-label="Share this page" hidden>
        <ShareArrow />
    </button>
    <button type="button" class="svgContainer copyLinkButton" aria-label="Copy page link to clipboard">
        <LinkIcon />
    </button>
    <!-- role="status" is a polite live region: screen readers announce its text
         when it changes, and sighted users see the same "Copied!" -->
    <span class="copyFeedback" role="status"></span>
</div>

<script>
    import * as u from "@/globals/browserUtilities"

    // This component renders twice per page (header + footer), so always
    // query all matches and scope feedback to the clicked button's container
    const copyButtons = u.getAllByQuery(".copyLinkButton", HTMLButtonElement);

    copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
            const container = button.parentElement;
            const feedback = container ? u.getByQuery(".copyFeedback", HTMLSpanElement, container) : null;

            try {
                await navigator.clipboard.writeText(window.location.href);
                if (feedback) {
                    feedback.textContent = "Copied!";
                    setTimeout(() => { feedback.textContent = ""; }, 2000);
                }
            } catch (error) {
                console.error("Unable to copy link to clipboard:", error);
                if (feedback) feedback.textContent = "Copy failed";
            }
        });
    });

    // navigator.share opens the OS share sheet; it exists on most mobile
    // browsers and some desktop ones. Only reveal the button where it works.
    if (navigator.share) {
        const shareButtons = u.getAllByQuery(".shareButton", HTMLButtonElement);
        shareButtons.forEach((button) => {
            button.hidden = false;
            button.addEventListener("click", async () => {
                try {
                    await navigator.share({ title: document.title, url: window.location.href });
                } catch {
                    // The user closing the share sheet rejects the promise — not an error
                }
            });
        });
    }
</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    $icon-size: 1rem;
    $padding: 1.25rem;
    $icon-color: #4569EB;
    $icon-border: #1d3486;

    .container {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: .4rem;
    }

    .svgContainer {

        width: calc($icon-size + $padding);
        height: calc($icon-size + $padding);

        display: flex;
        justify-content: center;
        align-items: center;

        background-color: $icon-color;
        border-radius: 100%;
        border: 2px solid $icon-border;
        cursor: pointer;

        // our display: flex would otherwise override the hidden attribute's
        // built-in display: none (author styles beat browser defaults)
        &[hidden] {
            display: none;
        }

        &:hover svg {
            transform: translateY(-1px);
        }

        &:active svg {
            transform: translateY(1px);
        }

        svg {
            width: $icon-size;
            height: $icon-size;
        }
    }

    .copyFeedback {
        font-size: .9rem;
        color: #747474;
    }

</style>
