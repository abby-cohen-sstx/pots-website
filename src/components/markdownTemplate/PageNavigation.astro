---
import { getEntry } from "astro:content";

import * as u from "@/globals/serverUtilities"

import RoundArrow from "@/images/RoundArrow.svg";

const { thisArticleID } = Astro.props;

const thisArticle = await getEntry("articles", thisArticleID);
const thisCollection = thisArticle?.data.collection;
const thisType = thisArticle?.data.type;

const allArticles = await u.sortArticles();
const filteredArticles = allArticles.filter(article => article.data.collection === thisCollection && article.data.type === thisType);

const thisIndex = filteredArticles.findIndex(article => article.id === thisArticleID);
const nextIndex = thisIndex === filteredArticles.length - 1 ?  0 : thisIndex + 1;
const previousIndex = thisIndex === 0 ? filteredArticles.length - 1 : thisIndex - 1;

const nextArticle = await getEntry("articles", filteredArticles[nextIndex].id);
const previousArticle = await getEntry("articles", filteredArticles[previousIndex].id);

---


<nav class="mainContainer">
    <a href=`/collections/${thisCollection?.toLowerCase()}` class="borderUnderline">
        <span class="darkGrayText">{thisCollection}</span>{thisCollection !== "Resources" && <span class="lightGrayText">&ensp;»&ensp;{thisType}</span>}
    </a>

    <div class="linkContainer">
        <a href=`/articles/${previousArticle?.id}` class="tooltipContainer borderUnderline" >
            <span class="svgContainer darkGrayText"><RoundArrow style="transform: rotate(180deg)" />Previous Article</span>
            <span class="tooltipText">{previousArticle?.data.title}</span>
        </a>
        <a href=`/articles/${nextArticle?.id}` class="tooltipContainer borderUnderline">
            <span class="svgContainer darkGrayText">Next Article <RoundArrow /></span>
            <span class="tooltipText">{nextArticle?.data.title}</span>
        </a>
    </div>
</nav>

<style lang="scss">
    @use "/src/styles/index" as *;

    .borderUnderline {
        border-bottom: 1px solid transparent;

        &:hover {
            border-bottom: 1px solid $light-gray-text;
            cursor: pointer;
        }
    }

    .mainContainer {
        width: 100%;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;

        a {
            text-decoration: none;
        }
    }

    .linkContainer {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 60px;
    }

    @media only screen and (max-width: $breakpoint) {
        .mainContainer {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .linkContainer {
            justify-content: space-between;
            width: 100%;
        }
    }

    .svgContainer {
        @include flex-row-center;
        gap: .5rem;

        svg {
            width: 1rem;
            height: 1rem;
        }
    }

    .tooltipContainer {
        position: relative; /* must set to position tooltipText absolute */
        display: inline-block;

        .tooltipText {
            visibility: hidden;
            max-width: 40ch;

            background-color: #fff;
            color: $light-gray-text;

            text-align: center;
            font-style: italic;
            display: block;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            

            border-radius: 6px;
            border: 1px solid #ececec;
            padding: 5px 10px;

            position: absolute;
            z-index: 1;
            top: 125%;
            left: 50%;
            transform: translateX(-50%);
        }

        &:hover .tooltipText {
            visibility: visible;
        }
    }

</style>