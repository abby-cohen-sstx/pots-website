---
import BaseLayout from "./BaseLayout.astro";
import * as M from '@/components/markdownTemplate';
import * as u from "@/globals/serverUtilities";

import type { CollectionEntry } from 'astro:content';

interface Props {
    frontmatter: CollectionEntry<"articles">["data"];
}

const { frontmatter } = Astro.props;
const thisArticleID = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';

let sortedList
if (frontmatter && frontmatter.referenceOrder) {
    sortedList = u.sortReferences(frontmatter?.references, frontmatter?.referenceOrder)
} else {
    [] // handled in ReferenceSection.astro
}

---

<BaseLayout pageTitle={frontmatter.title}>
    
    <div class="mainContainer">
        <header style="width: 100%">
            <div class="bodyPadding">
                <M.PageNavigation thisArticleID={thisArticleID} />
            </div>
            <hr class="extra-light-hr">
            <div class="bodyPadding" style="margin-bottom: 3rem">
                <div class="headerContainer">
                    <h1>{frontmatter.header}</h1>
                    <M.LinkShareButtons />
                </div>
                
                <h2>{frontmatter.subheader}</h2>
            </div>

            <hr class="light-hr">
        </header>

        <div class="bodyPadding">
            <main>
                <article>
                    <slot />
                </article>
            </main>
        </div>
        
        <div class="bodyPadding" style="display: flex; flex-direction: row; justify-content: flex-start; width: 100%; margin-top: 2rem;">
            <M.LinkShareButtons />
        </div>

        <footer style="width: 100%">
            <hr class="extra-light-hr">
            <div class="bodyPadding footerButtonsContainer">
                <M.MedicalDisclaimer />
                <M.PageNavigation thisArticleID={thisArticleID} />
            </div>
            <hr class="light-hr">
            <div class="bodyPadding">
                <M.ReferencesSection referenceList={sortedList} showLinks={true} heading="References" />
            </div>
            <div class="tocPadding"></div>
        </footer>
    </div>

    <div class="sideTocContainer">
        <M.TableOfContents thisArticleID={thisArticleID} position="side" />
    </div>

    <div class="bottomToc" id="bottomTocOuterHolder">
        <div class="tocContainer" id="bottomTocContainer" data-open="false">
            <M.TableOfContents thisArticleID={thisArticleID} position="bottom" />
        </div>
        <button class="bottomTocButton" id="bottomTocButton">Show Table of Contents</button>
    </div>
</BaseLayout>

<script>
    import * as u from "@/globals/browserUtilities"

    const bottomToc = u.getByID("bottomTocOuterHolder", HTMLDivElement);
    const bottomButton = u.getByID("bottomTocButton", HTMLButtonElement);
    const bottomContainer = u.getByID("bottomTocContainer", HTMLDivElement);
    let bottomOpen = false;

    function closeBottomToc() {
        bottomOpen = false;
        // bottomContainer.style.display = "none";
        bottomContainer.setAttribute("data-open", "false")
        bottomButton.textContent = "Show Table of Contents";
    }

    function openBottomToc() {
        bottomOpen = true;
        // bottomContainer.style.display = "block";
        bottomContainer.setAttribute("data-open", "true")
        bottomButton.textContent = "Hide Table of Contents";
    }

    bottomButton.onclick = () => {bottomOpen?closeBottomToc():openBottomToc()};

    // Close when the user clicks off the menu or clicks on a link
    document.body.addEventListener("click", event => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        if ((!bottomToc.contains(target)) || (target.parentElement?.id === "bottomTocLinks")) {
            closeBottomToc();
        }
    })



</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    .bodyPadding {
        padding: 0px 5px;
    }

    h1, h2, h3 {
        font-family: "Koh Santepheap", sans-serif;
    }

    h1 {
        font-weight: 700;
        font-size: 2.5rem;
    }

    h2 {
        max-width: 60%;
        font-weight: 500;
        font-size: 1.5rem;
    }

    .mainContainer {
        @include flex-column-center;
    }

    .headerContainer {
        display: flex;
        flex-direction: row;
        justify-content:space-between;
        align-content: center;

        margin-bottom: 1rem;
    }

    .footerButtonsContainer {
        @include flex-column-start;
    }

    
    @media only screen and (max-width: $breakpoint) {
        h2 {
            max-width: 100%;
        }
    }

    .sideTocContainer {
        
        position: fixed;
        width: calc(50% - ($max-width / 2) + $global-inline-padding);
        min-height: 100%;
        left: 0px;
        top: 0px;
        z-index: 50;

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        display: none;
        
    }

    .bottomToc {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: white;
        padding: .5rem;
        border-top: 1px solid #2e2e2e;
        z-index: 100000;
        @include flex-column-center;

        .bottomTocButton {
            background-color: #ffffff;
            padding: .25rem .5rem;
            border: 1px solid #404040;
            border-radius: 3px;

            &:hover {
                background-color: #f8f8f8;
                cursor: pointer;
            }
        }
    }

    @supports (interpolate-size: allow-keywords) {
        .bottomToc {
            interpolate-size: allow-keywords;
        }

        .tocContainer {
            block-size: 0;
            transition: content-visibility, block-size;
            transition-duration: .6s;
            transition-behavior: allow-discrete;
            
            overflow: hidden;
        }

        .tocContainer[data-open="true"] {
            block-size: auto;
        }
    }

    .tocPadding {
        margin-bottom: 4rem;
    }

    @media only screen and (min-width: 120rem) {
        .sideTocContainer {
            display: flex;
        }

        .bottomToc {
            display: none;
        }
    }

</style>

