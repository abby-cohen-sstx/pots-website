---
import BaseLayout from "./BaseLayout.astro";
import * as M from '@/components/markdownTemplate';
import * as u from "@/globals/serverUtilities";

import type { CollectionEntry } from 'astro:content';

interface Props {
    frontmatter: CollectionEntry<"articles">["data"];
}

const { frontmatter } = Astro.props;
const thisArticleID = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';

let sortedList
if (frontmatter && frontmatter.referenceOrder) {
    sortedList = u.sortReferences(frontmatter?.references, frontmatter?.referenceOrder)
} else {
    [] // handled in ReferenceSection.astro
}

---

<BaseLayout pageTitle={frontmatter.title}>
    <div class="markdownContainer">
        <header style="width: 100%">
            <div class="bodyPadding">
                <M.PageNavigation thisArticleID={thisArticleID} />
            </div>
            <hr class="extra-light-hr">
            <div class="bodyPadding" style="margin-bottom: 3rem">
                <div style="display: flex; flex-direction: row; justify-content:space-between; align-content: center;">
                    <h1>{frontmatter.header}</h1>
                    <M.LinkShareButtons />
                </div>
                
                <h2>{frontmatter.subheader}</h2>
            </div>

            <hr class="light-hr">
        </header>

        <div class="bodyPadding">
            <main>
                <article>
                    <slot />
                </article>
            </main>
        </div>
        
        <div class="bodyPadding" style="display: flex; flex-direction: row; justify-content: flex-start; width: 100%; margin-top: 2rem;">
            <M.LinkShareButtons />
        </div>

        <footer style="width: 100%">
            <hr class="extra-light-hr">
            <div class="bodyPadding footerButtonsContainer">
                <M.MedicalDisclaimer />
                <M.PageNavigation thisArticleID={thisArticleID} />
            </div>
            <hr class="light-hr">
            <div class="bodyPadding">
                <M.ReferencesSection referenceList={sortedList} showLinks={true} heading="References" />
            </div>
        </footer>

    </div>
</BaseLayout>

<style lang="scss">
    @use "/src/styles/index" as *;

    .bodyPadding {
        padding: 0px 5px;
    }

    h1, h2 {
        font-family: "Koh Santepheap", sans-serif;
    }

    h1 {
        margin-bottom: 1rem;
        font-weight: 600;
    }

    h2 {
        max-width: 60%;
        font-weight: 500;
    }

    .markdownContainer {
        @include flex-column-center;
    }

    .footerButtonsContainer {
        @include flex-column-start;
    }

</style>

