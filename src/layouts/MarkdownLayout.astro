---
/*

import PageNavigation from '../components/articleLayout/PageNavigation.astro';
import ExpandFootnotes from '../components/articleLayout/ExpandFootnotes.astro';
import LinkShareButtons from '../components/articleLayout/LinkShareButtons.astro';
import MedicalDisclaimer from '../components/articleLayout/MedicalDisclaimer.astro';
*/

import BaseLayout from "./BaseLayout.astro";
import * as M from '@/components/markdownTemplate';

const { frontmatter } = Astro.props;

---

<BaseLayout pageTitle={frontmatter.title}>
    <div class="markdownContainer">
        <header style="width: 100%">
            <div class="bodyPadding">
                <M.PageNavigation />
                <hr class="light-hr">

                <h1>{frontmatter.header}</h1>
                <h2>{frontmatter.subheader}</h2>

                <div class="headerButtonsContainer">
                    <M.ExpandFootnotes />
                    <M.LinkShareButtons />
                </div>
            </div>

            <hr class="heavy-hr">
        </header>

        <div class="bodyPadding">
            <main>
                <article>
                    <slot />
                </article>
            </main>
        </div>
        
        <footer style="width: 100%">
            <hr class="light-hr">
            <div class="bodyPadding footerButtonsContainer">
                <M.LinkShareButtons /> <!--Need to make these not collapse after breakpoint -->
                <M.MedicalDisclaimer />
                <M.PageNavigation />
            </div>
            <hr class="heavy-hr">
            <div class="bodyPadding">
                <h1>References</h1>
            </div>
            
            
        </footer>

    </div>
</BaseLayout>

<style lang="scss">
    @use "/src/styles/index" as *;

    .bodyPadding {
        padding: 0px 5px;
    }

    .markdownContainer {
        @include flex-column-center;
    }

    .headerButtonsContainer {
        @include flex-row-space-between;
        margin-top: 40px;
    }

    .footerButtonsContainer {
        @include flex-column-start;
    }

</style>

