---
import BaseLayout from "./BaseLayout.astro";
import * as M from '@/components/markdownTemplate';

import { REFERENCES } from "@/globals/references";

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
    article: CollectionEntry<"articles">;
    headings: MarkdownHeading[];
    citedIds: string[];
}

const { article, headings, citedIds } = Astro.props;
const frontmatter = article.data;

// Resolve cited ids against the central store, in citation order. A typo'd id
// fails the build here, naming the article and the id.
const referenceList = citedIds.map(id => {
    const reference = REFERENCES[id];
    if (!reference) {
        throw new Error(`Article "${article.id}" cites unknown reference id "${id}" — check src/globals/references.json`);
    }
    return reference;
});

// "Last updated" shows updatedDate when present, else pubDate. Formatted in
// UTC because YAML dates parse to midnight UTC — local-time formatting would
// show the previous day (same bug class as the old citation dates).
const displayDate = frontmatter.updatedDate ?? frontmatter.pubDate;
const displayDateText = displayDate.toLocaleDateString("en-US", {
    timeZone: "UTC", year: "numeric", month: "long", day: "numeric",
});

---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
    
    <div class="mainContainer">
        <header style="width: 100%">
            <div class="bodyPadding">
                <M.PageNavigation article={article} />
            </div>
            <hr class="extra-light-hr">
            <div class="bodyPadding" style="margin-bottom: 3rem">
                <div class="headerContainer">
                    <h1>{frontmatter.header}</h1>
                    <M.LinkShareButtons />
                </div>
                
                <p class="subheader">{frontmatter.subheader}</p>
                <p class="lastUpdated">Last updated: <time datetime={displayDate.toISOString().split("T")[0]}>{displayDateText}</time></p>
            </div>

            <hr class="light-hr">
        </header>

        <div class="bodyPadding">
            <main>
                <article>
                    <slot />
                </article>
            </main>
        </div>
        
        <div class="bodyPadding" style="display: flex; flex-direction: row; justify-content: flex-start; width: 100%; margin-top: 2rem;">
            <M.LinkShareButtons />
        </div>

        <footer style="width: 100%">
            <hr class="extra-light-hr">
            <div class="bodyPadding footerButtonsContainer">
                <M.MedicalDisclaimer />
                <M.PageNavigation article={article} />
            </div>
            <hr class="light-hr">
            <div class="bodyPadding">
                <M.ReferencesSection referenceList={referenceList} showLinks={true} heading="References" />
            </div>
            <div class="tocPadding"></div>
        </footer>
    </div>

    <div class="sideTocContainer">
        <M.TableOfContents headings={headings} position="side" />
    </div>

    <div class="bottomToc" id="bottomTocOuterHolder">
        <div class="tocContainer" id="bottomTocContainer" data-open="false">
            <M.TableOfContents headings={headings} position="bottom" />
        </div>
        <button class="bottomTocButton" id="bottomTocButton">Show Table of Contents</button>
    </div>
</BaseLayout>

<script>
    import * as u from "@/globals/browserUtilities"

    const bottomToc = u.getByID("bottomTocOuterHolder", HTMLDivElement);
    const bottomButton = u.getByID("bottomTocButton", HTMLButtonElement);
    const bottomContainer = u.getByID("bottomTocContainer", HTMLDivElement);
    let bottomOpen = false;

    function closeBottomToc() {
        bottomOpen = false;
        // bottomContainer.style.display = "none";
        bottomContainer.setAttribute("data-open", "false")
        bottomButton.textContent = "Show Table of Contents";
    }

    function openBottomToc() {
        bottomOpen = true;
        // bottomContainer.style.display = "block";
        bottomContainer.setAttribute("data-open", "true")
        bottomButton.textContent = "Hide Table of Contents";
    }

    bottomButton.onclick = () => {bottomOpen?closeBottomToc():openBottomToc()};

    // Close when the user clicks off the menu or clicks on a TOC link
    document.body.addEventListener("click", event => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const clickedTocLink = target.closest("li.bottomTocLinks") !== null;
        if (!bottomToc.contains(target) || clickedTocLink) {
            closeBottomToc();
        }
    })



</script>

<style lang="scss">
    @use "/src/styles/index" as *;

    .bodyPadding {
        padding: 0px 5px;
    }

    h1, .subheader {
        font-family: "Koh Santepheap", sans-serif;
    }

    h1 {
        font-weight: 700;
        font-size: 2.5rem;
    }

    .subheader {
        max-width: 60%;
        font-weight: 500;
        font-size: 1.5rem;
    }

    .lastUpdated {
        margin-top: .5rem;
        font-size: .9rem;
        color: #747474;
    }

    /* Article prose starts at h2 — the page h1 is the article header and the
       subheader is a styled <p>, so ## in markdown is the top section level */
    article :global(h2) {
        font-weight: 600;
        font-size: 1.5rem;
    }

    article :global(h3) {
        font-weight: 600;
        font-size: 1.25rem;
    }

    article :global(h4) {
        font-weight: 500;
        font-size: 1.2rem;
    }

    .mainContainer {
        @include flex-column-center;
    }

    .headerContainer {
        display: flex;
        flex-direction: row;
        justify-content:space-between;
        align-content: center;

        margin-bottom: 1rem;
    }

    .footerButtonsContainer {
        @include flex-column-start;
    }

    
    @media only screen and (max-width: $breakpoint) {
        .subheader {
            max-width: 100%;
        }
    }

    .sideTocContainer {
        
        position: fixed;
        width: calc(50% - ($max-width / 2) + $global-inline-padding);
        min-height: 100%;
        left: 0px;
        top: 0px;
        z-index: 50;

        // hidden by default; the 120rem media query below sets display: flex
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        display: none;
    }

    .bottomToc {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: white;
        padding: .5rem;
        border-top: 1px solid #2e2e2e;
        z-index: 100000;
        @include flex-column-center;

        .bottomTocButton {
            background-color: #ffffff;
            padding: .25rem .5rem;
            border: 1px solid #404040;
            border-radius: 3px;

            &:hover {
                background-color: #f8f8f8;
                cursor: pointer;
            }
        }
    }

    @supports (interpolate-size: allow-keywords) {
        .bottomToc {
            interpolate-size: allow-keywords;
        }

        .tocContainer {
            block-size: 0;
            transition: content-visibility, block-size;
            transition-duration: .6s;
            transition-behavior: allow-discrete;
            
            overflow: hidden;
        }

        .tocContainer[data-open="true"] {
            block-size: auto;
        }
    }

    .tocPadding {
        margin-bottom: 4rem;
    }

    @media only screen and (min-width: 120rem) {
        .sideTocContainer {
            display: flex;
        }

        .bottomToc {
            display: none;
        }
    }

</style>
