---
import BaseLayout from "./BaseLayout.astro";
import PageNavigation from '../components/article/PageNavigation.astro';
import ExpandFootnotes from '../components/article/ExpandFootnotes.astro';
import LinkShareButtons from '../components/article/LinkShareButtons.astro';
import MedicalDisclaimer from '../components/article/MedicalDisclaimer.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
    <div class="markdownMainContainer">
        <header>
            <div class="bodyPadding">
                <PageNavigation />
                <div style="margin-top:50px"></div>

                <h1>{frontmatter.header}</h1>
                <h2>{frontmatter.subheader}</h2>
                <div class="headerButtonsContainer">
                    <ExpandFootnotes />
                    <div></div>
                    <div>
                        <LinkShareButtons />
                    </div>
                </div>
            </div>

            <hr class="heavy-hr">
        </header>

        <div class="bodyPadding">
            <slot />
        </div>
        
        <footer>
            <hr class="light-hr">
            <div class="bodyPadding" style="display:flex; align-items:flex-start; flex-direction: column;">
                <LinkShareButtons />
                <PageNavigation />
                <MedicalDisclaimer />
            </div>
            <hr class="heavy-hr">
            <h1>References</h1>
            
        </footer>

    </div>
</BaseLayout>

<style>
    h1 {

    }

    h2 {
        font-weight: normal;
    }

    .bodyPadding {
        padding: 0px 5px;
    }


    .light-hr {
        width: 100%;
        height: 1px;
        border-width: 0;
        background-color: rgb(192, 192, 192);
        margin: 20px 0px;
    }

    .heavy-hr {
        width: 100%;
        height: 1px;
        border-width: 0;
        background-color: rgb(118, 118, 118);
        margin: 20px 0px;
    }

    .markdownMainContainer {
        width: 100%;
        max-width: 900px;

        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .markdownMainContainer header {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .markdownMainContainer * {
        text-align: left;
    }

    .headerButtonsContainer {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-top: 40px;
    }

</style>

