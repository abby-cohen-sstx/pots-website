---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReferencesSection from "@/components/markdownTemplate/ReferencesSection.astro";

import { REFERENCES } from "@/globals/references";

// Site-wide general sources, in display order. Ids are Zotero/Better BibTeX
// citation keys from the central store in src/globals/references.ts.
const GENERAL_SOURCE_IDS = [
    "lauPosturalOrthostaticTachycardia2026",
    "xuPediatricPosturalOrthostatic2024",
    "steinbergNarrativeReviewPostural2023",
];

const referenceList = GENERAL_SOURCE_IDS.map(id => {
    const reference = REFERENCES[id];
    if (!reference) throw new Error(`reference-sources: unknown reference id "${id}"`);
    return reference;
});

---

<BaseLayout pageTitle="Sources">
    <ReferencesSection referenceList={referenceList} showLinks={false} heading="General Reference Sources" headingLevel="h1" />
</BaseLayout>
