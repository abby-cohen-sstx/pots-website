---
import { getCollection, render } from 'astro:content';
import MarkdownLayout from '@/layouts/MarkdownLayout.astro';
import { Cite, Figure } from '@/components/inlineContent';

// getStaticPaths() gives astro a list of every page this dynamic route produces. Runs once
// params = where the page lives
// props = what the page knows
export async function getStaticPaths() {
    const articles = await getCollection("articles");
    return articles.map((article) => ({
        params: { slug: article.id }, // { slug: "what-is-pots" } -> /articles/what-is-pots
        props: { article }, // the entire article object stored in the collection
    }));
}

// Everything that follows runs once per article
const { article } = Astro.props; // the same article object passed to props in getStaticPaths()
const { Content, headings, remarkPluginFrontmatter } = await render(article);

// Ordered list of reference ids cited in the prose, computed by the
// remark-citations plugin (src/plugins/remark-citations.mjs)
const citedIds = (remarkPluginFrontmatter.citedIds as string[] | undefined) ?? [];
---

<MarkdownLayout article={article} headings={headings} citedIds={citedIds}>
    <Content components={{ Cite, Figure }} />
</MarkdownLayout>
