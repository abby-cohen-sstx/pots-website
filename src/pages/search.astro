---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchIcon from "@/images/SearchIcon.svg"
import ClearIcon from "@/images/CloseIcon.svg"


---

<BaseLayout pageTitle={"Search All Articles"}>
	<main class="homeContainer">
		<h1>Search</h1>

        <div class="search">
            <div class="fullPage">
                <div class="box">
                    <label for="searchPageInput">Search all articles</label>
                    <div class="wrapper">
                        <SearchIcon class="searchIcon" />
                        <input type="search" name="search" id="searchPageInput" class="input" placeholder="Search...">
                        <ClearIcon class="clearIcon" id="searchPageClearIcon" />
                    </div>
                    <p id="searchName"></p>
                </div>

                <section aria-label="Search Results" class="results">
                    <ul id="searchResults">
                    </ul>
                </section>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    import Search from "@/scripts/search"

    Search();
</script>

<style lang="scss">
	@use "/src/styles/index" as *;

	.homeContainer {
		@include flex-center;
		flex-direction: column;
		gap: 20px;
	}

</style>