---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchIcon from "@/images/SearchIcon.svg"
import ClearIcon from "@/images/CloseIcon.svg"


---

<BaseLayout pageTitle={"Search All Articles"}>
	<main class="mainContainer">
		<h1>Search</h1>

        <div class="search">
            <div class="box">
                <label for="searchPageInput">Search all articles</label>
                <div class="wrapper">
                    <SearchIcon class="searchIcon" />
                    <input type="search" name="search" id="searchPageInput" class="input" placeholder="Search...">
                    <ClearIcon class="clearIcon" id="searchPageClearIcon" />
                </div>
                <p id="searchName"></p>
            </div>

            <section aria-label="Search Results">
                <ul id="searchResults" class="resultsList">
                    <li>
                        <div>
                            <h3>What is POTS?</h3>
                            <p>This exaggerated heart rate response reflects the body’s attempt to compensate for impaired blood flow back to the heart and brain</p>
                        </div>
                    </li>
                </ul>
            </section>
        </div>
    </main>
</BaseLayout>

<script>
    import Search from "@/scripts/search"

    Search();
</script>

<style lang="scss">
	@use "/src/styles/index" as *;

	.mainContainer {
		@include flex-center;
		flex-direction: column;
		gap: 20px;
	}

    /* Must use global classes to style search results, since they are added outside of the component */

</style>