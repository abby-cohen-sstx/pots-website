---
import { getCollection } from "astro:content";
import { ARTICLE_ORDER } from "@/globals/articleOrder";
import { COLLECTION_LIST } from "@/globals/collectionList"

import * as u from '@/globals/utilities';

export async function getStaticPaths() {
  return COLLECTION_LIST.map((collection) => ({
    params: { collection: collection.toLowerCase() },
    props: { collectionEnum: collection },
  }));
}

const { collectionEnum } = Astro.props; // Display name of current collection

const articles = await u.sortArticles();

---

<h1>{collectionEnum}</h1>

<ul>
  {articles.map((article) => (
    <li>
      <a href={`/articles/${article.id}`}>{article.data.title}</a>
    </li>
  ))}
</ul>