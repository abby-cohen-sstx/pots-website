---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { COLLECTION_LIST } from "@/globals/collectionList"

import * as u from '@/globals/serverUtilities';

export async function getStaticPaths() {
  return COLLECTION_LIST.map((collection) => ({
    params: { collection: collection.toLowerCase() },
    props: { thisCollection: collection },
  }));
}

const { thisCollection } = Astro.props; // Display name of current collection

const articles = u.articlesByType(thisCollection, await u.sortArticles())
const types = Object.keys(articles)

---
<BaseLayout pageTitle={thisCollection}>
  <h1>{thisCollection}</h1>

  <ul>
    {types.map(type => {
      return (
        <h2 class={`typeTitle${type}`}>{type}</h2>
        <ul>
          {articles[type].map(article => {
            return(<li><a href=`/articles/${article.id}`>{article.data.title}</a></li>)
          })}
        </ul>
      )
    })}
  </ul>
</BaseLayout>

<style lang="scss">

</style>
